{
  "id": "/admin",
  "name": "Al-Madina Admin",
  "short_name": "AMJ Admin",
  "description": "The shop's own panel: today's gold rate, pieces, orders, enquiries and visits.",
  "lang": "en-PK",
  "dir": "ltr",
  "start_url": "/admin",
  "scope": "/admin",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#201E1B",
  "theme_color": "#201E1B",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "/admin-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/admin-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "/admin-icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/admin-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Set today's gold rate",
      "short_name": "Gold rate",
      "url": "/admin/rates",
      "icons": [{ "src": "/admin-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Products",
      "short_name": "Products",
      "url": "/admin/products",
      "icons": [{ "src": "/admin-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Enquiries",
      "short_name": "Enquiries",
      "url": "/admin",
      "icons": [{ "src": "/admin-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
